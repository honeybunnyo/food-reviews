generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RecipeUpload {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  title       String?
  description String?
  rating      Int?     @db.SmallInt

  recipe Json? // array of strings (ingredients / bullet points)
  method Json? // array of steps

  backgroundImageUrl   Json?
  descriptionImageUrls Json?
  recipeImageUrls      Json?
  methodImageUrls      Json?
  notes                String?
}

model RestaurantUpload {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  title       String?
  rating      Int?     @db.SmallInt
  review      String?
  location    String?
  priceRange  String?
  description String?

  entree  Json?
  main    Json?
  dessert Json?

  backgroundImageUrl   Json?
  descriptionImageUrls Json?
  entreeImageUrls      Json?
  mainImageUrls        Json?
  dessertImageUrls     Json?
  notes                String?
}
